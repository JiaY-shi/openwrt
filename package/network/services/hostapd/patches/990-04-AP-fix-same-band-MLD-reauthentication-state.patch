--- a/src/ap/sta_info.c
+++ b/src/ap/sta_info.c
@@ -144,7 +144,7 @@
 const u8 * ap_sta_link_addr(struct hostapd_data *hapd, struct sta_info *sta)
 {
 #ifdef CONFIG_IEEE80211BE
-	const u8 *link_addr = sta->mld_info.links[hapd->mld_link_id].peer_addr;
+	const u8 *link_addr = sta->auth_link_addr;
 
 	if (ap_sta_is_mld(hapd, sta) && !is_zero_ether_addr(link_addr))
 		return link_addr;
@@ -414,6 +414,37 @@
 	sta->flags |= WLAN_STA_AUTH;
 	ap_sta_set_sa_query_timeout(hapd, sta, 0);
 	return 0;
+}
+
+
+void ap_sta_clear_failed_mld_auth(struct hostapd_data *hapd,
+				  struct sta_info *psta)
+{
+	struct hostapd_data *lhapd;
+
+	if (!ap_sta_is_mld(hapd, psta))
+		return;
+
+	for_each_mld_link(lhapd, hapd) {
+		struct sta_info *lsta;
+		struct wpa_state_machine *sm;
+
+		if (lhapd == hapd)
+			continue;
+
+		lsta = ap_get_sta(lhapd, psta->addr);
+		if (!lsta || lsta == psta ||
+		    ((lsta->flags & WLAN_STA_MFP) &&
+		     ap_sta_is_authorized(lsta)))
+			continue;
+
+		sm = lsta->wpa_sm;
+		if (!sm || sm == psta->wpa_sm)
+			continue;
+
+		clear_wpa_sm_for_all_sta(lhapd, sm);
+		wpa_auth_sta_deinit(sm);
+	}
 }
 
 #endif /* CONFIG_IEEE80211BE */
