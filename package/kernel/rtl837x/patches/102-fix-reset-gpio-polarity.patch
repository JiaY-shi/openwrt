From: JiaY-shi <shi05275@163.com>
Subject: [PATCH] rtl837x: respect GPIO polarity when resetting the switch

GPIO descriptor values already account for the reset line polarity.
Assert reset with logical one and release it with logical zero so an
active-low reset line is not held asserted when detecting the switch.

--- a/src/rtl837x_mdio.c
+++ b/src/rtl837x_mdio.c
@@ -222,7 +222,7 @@ static int rtl837x_mdio_probe(struct mdio_device *mdiodev)
 
 	dev_set_drvdata(dev, priv);
 
-	priv->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	priv->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
 	if (IS_ERR(priv->reset)) {
 		dev_err(dev, "failed to get RESET GPIO\n");
 		ret = PTR_ERR(priv->reset);
@@ -230,12 +230,12 @@ static int rtl837x_mdio_probe(struct mdio_device *mdiodev)
 	}
 
 	if (priv->reset) {
-		// This chip takes a long time to fully reset
-		dev_dbg(dev, "asserted RESET\n");
-		gpiod_set_value_cansleep(priv->reset, 0);
-		usleep_range(50000, 51100);
+		/* Logical one asserts reset regardless of GPIO polarity. */
+		dev_dbg(dev, "asserting RESET\n");
 		gpiod_set_value_cansleep(priv->reset, 1);
 		usleep_range(50000, 51100);
+		gpiod_set_value_cansleep(priv->reset, 0);
+		usleep_range(50000, 51100);
 		dev_dbg(dev, "deasserted RESET\n");
 	}
 
