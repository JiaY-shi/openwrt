From: JiaY-shi <shi05275@163.com>
Subject: [PATCH] rtl8372n: propagate MDIO read errors

Reject negative MDIO read results before assembling a switch register value.
Identify the module independently of its original MT7988 platform.

diff --git a/src/rtl837x_mdio.c b/src/rtl837x_mdio.c
index 2a9d5e7..b2c3536 100644
--- a/src/rtl837x_mdio.c
+++ b/src/rtl837x_mdio.c
@@ -59,9 +59,16 @@ static int rtl837x_mdio_read(void *ctx, u32 reg, u32 *val)
 
 	val_l = bus->read(bus, priv->mdio_addr, MDC_MDIO_DATA_LOW);
 	val_h = bus->read(bus, priv->mdio_addr, MDC_MDIO_DATA_HIGH);
+	if (val_l < 0) {
+		ret = val_l;
+		goto out_unlock;
+	}
+	if (val_h < 0) {
+		ret = val_h;
+		goto out_unlock;
+	}
 
-	*val = val_l & 0xffff;
-	*val |= (val_h & 0xffff) << 16;
+	*val = (val_l & 0xffff) | ((val_h & 0xffff) << 16);
 	ret = 0;
 
 out_unlock:
@@ -368,4 +375,4 @@ mdio_module_driver(rtl837x_mdio_driver);
 
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("StarField Xu <air_jinkela@163.com>");
-MODULE_DESCRIPTION("rtl8372n switch driver for MT7988");
+MODULE_DESCRIPTION("Realtek RTL8372N DSA switch driver");
