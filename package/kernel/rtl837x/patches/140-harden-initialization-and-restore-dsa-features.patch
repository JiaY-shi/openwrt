+		ret = rtl837x_reg_bits_write(priv, RTL8373_MSPT_STATE_ADDR(i),
 				  RTL8373_STP_STATE_MASK(port), val
 				);
+		if (ret)
+			return ret;
 	}
+
+	return 0;
+}
