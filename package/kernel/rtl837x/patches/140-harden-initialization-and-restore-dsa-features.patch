From: JiaY-shi <shi05275@163.com>
Subject: [PATCH] net: dsa: rtl8372n: harden setup and restore DSA features

Restore the DSA features provided by the vendor driver and make switch
initialization fail when required register or PHY setup fails. Fix reset
polarity handling and the RTL8224 regmap lock context as well.

Signed-off-by: JiaY-shi <shi05275@163.com>
---
--- a/src/rtl8372n.c
+++ b/src/rtl8372n.c
@@ -247,7 +247,10 @@ static int rtl8372n_detect(struct rtl837
     switch_chip_t sw_chip;
 
 	ret = rtl837x_reg_read(priv, RTL8373_MODEL_NAME_INFO_ADDR, &val);
-    dev_info(dev, "CHIP_ID: 0x%08x \n", val);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "CHIP_ID: 0x%08x \n", val);
 
 	switch (val >> 8)
 	{
@@ -787,14 +790,18 @@ static const struct phylink_mac_ops rtl8
 */
 static int of_extra_init(struct dsa_switch *ds)
 {
-    struct rtl837x_priv *priv = ds->priv;
+	struct rtl837x_priv *priv = ds->priv;
 	struct device_node *np = ds->dev->of_node;
 	const __be32 *list;
-	int size, data_len;
+	int size, data_len, ret;
 	u32 reg, mask, val;
 
 	list = of_get_property(np, "extra-init", &size);
-	if (!list || !size) return 0;
+	if (!list || !size)
+		return 0;
+	if (size % (3 * sizeof(*list)))
+		return dev_err_probe(ds->dev, -EINVAL,
+				     "extra-init must contain register/mask/value triplets\n");
 
 	data_len = size / (3*sizeof(__be32));
 	for (int i=0; i<data_len; i++)
@@ -807,7 +814,11 @@ static int of_extra_init(struct dsa_swit
 		list++;
 		dev_dbg(ds->dev, "of_extra_init: reg:0x%04X mask:0x%08X val:0x%08X\n", 
 							reg, mask, val);
-		rtl837x_reg_bits_write(priv, reg, mask, val);
+		ret = rtl837x_reg_bits_write(priv, reg, mask, val);
+		if (ret)
+			return dev_err_probe(ds->dev, ret,
+					     "failed extra-init register 0x%04x\n",
+					     reg);
 	}
 	return 0;
 }
@@ -1427,6 +1438,38 @@ static void rtl8372n_get_ctrl_stats(stru
 	mutex_unlock(&priv->mib_lock);
 }
 
+static void rtl8372n_get_pause_stats(struct dsa_switch *ds, int port,
+				      struct ethtool_pause_stats *pause_stats)
+{
+	struct rtl837x_priv *priv = ds->priv;
+
+	pause_stats->rx_pause_frames = 0;
+	pause_stats->tx_pause_frames = 0;
+
+	mutex_lock(&priv->mib_lock);
+	priv->ops->get_mib_counter(priv, port,
+		&priv->mib_counters[RTL837X_MIB_dot3InPauseFrames],
+		&pause_stats->rx_pause_frames);
+	priv->ops->get_mib_counter(priv, port,
+		&priv->mib_counters[RTL837X_MIB_dot3OutPauseFrames],
+		&pause_stats->tx_pause_frames);
+	mutex_unlock(&priv->mib_lock);
+}
+
+static int rtl8372n_set_ageing_time(struct dsa_switch *ds,
+				     unsigned int msecs)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	unsigned int secs = DIV_ROUND_UP(msecs, MSEC_PER_SEC);
+
+	secs = clamp_t(unsigned int, secs, 14, 800);
+
+	/* The RTL8372N SDK represents one second as five age-unit ticks. */
+	return rtl837x_reg_bits_write(priv, RTL8373_L2_AGE_CTRL_ADDR,
+				       RTL8373_L2_AGE_CTRL_AGE_UNIT_MASK,
+				       secs * 5);
+}
+
