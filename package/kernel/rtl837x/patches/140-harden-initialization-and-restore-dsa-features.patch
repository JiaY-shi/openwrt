 		dev_err(priv->dev, "[%s]: unknown bridge state requested\n", __func__);
-		return;
+		return -EINVAL;
 	}
 
 	/* Set the same status for the port on all the FIDs */
 	for (int i = 0; i <= RTL837x_FIDMAX; i++) {
-		rtl837x_reg_bits_write(priv, RTL837X_MSPT_STATE_ADDR(i),
+		ret = rtl837x_reg_bits_write(priv, RTL837X_MSPT_STATE_ADDR(i),
 				  RTL837X_MSTP_STATE_MASK(port), val
 				);
+		if (ret)
+			return ret;
 	}
+
+	return 0;
+}
+
+static void rtl8372n_port_stp_state_set(struct dsa_switch *ds, int port,
+					u8 state)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	int ret;
+
+	ret = __rtl8372n_port_stp_state_set(ds, port, state);
+	if (ret)
+		dev_err(priv->dev, "failed to set STP state %u on port %d: %d\n",
+			state, port, ret);
 }
 
