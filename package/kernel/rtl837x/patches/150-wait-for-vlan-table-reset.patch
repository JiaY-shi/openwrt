From: JiaY-shi <shi05275@163.com>
Subject: [PATCH] rtl8372n: wait for VLAN table reset

Wait for the asynchronous reset to complete before DSA programs VLANs.

diff --git a/src/rtl8372n.c b/src/rtl8372n.c
index 1c32b5f..0d1f556 100644
--- a/src/rtl8372n.c
+++ b/src/rtl8372n.c
@@ -2582,6 +2582,7 @@ static int rtl8372n_setup(struct dsa_switch *ds)
 {
 	int ret;
 	struct rtl837x_priv *priv = ds->priv;
+	u32 val;
 	struct device_node *np = priv->dev->of_node;
 	struct rtl8372n *chip_data = priv->chip_data;
 	struct dsa_port *dp;
@@ -2843,6 +2844,13 @@ static int rtl8372n_setup(struct dsa_switch *ds)
 	if (ret)
 		return ret;
 
+	ret = regmap_read_poll_timeout(priv->map, RTL837X_VLAN_CTRL_ADDR, val,
+				       !(val & RTL837X_VLAN_CTRL_TABLE_RST_MASK),
+				       10, 100000);
+	if (ret)
+		return dev_err_probe(priv->dev, ret,
+				     "VLAN table reset timed out\n");
+
 	dsa_switch_for_each_port(dp, ds) {
 		int port = dp->index;
