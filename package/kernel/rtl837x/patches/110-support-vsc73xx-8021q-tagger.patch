From: JiaY-shi <shi05275@163.com>
Subject: [PATCH] rtl8372n: support the VSC73XX 802.1Q tagger

Use the switch's service-tag path with the VSC73XX tagger so IPQ5332 PPE
can offload traffic without generating the proprietary RTL8_4 header.

diff --git a/src/rtl8372n.c b/src/rtl8372n.c
index 07a48f3..672934c 100644
--- a/src/rtl8372n.c
+++ b/src/rtl8372n.c
@@ -239,16 +239,6 @@ struct rtl8372n {
 	bool dsa_tag_8021q_vid[RTL8372N_VLAN_MAX+1];
 };
 
-static bool is_8021q_tag(enum dsa_tag_protocol tag_proto)
-{
-	switch (tag_proto) {
-	case DSA_TAG_PROTO_MXL862_8021Q:
-		return true;
-	default:
-		return false;
-	}
-}
-
 static int rtl8372n_detect(struct rtl837x_priv *priv)
 {
 	struct device *dev = priv->dev;
@@ -543,6 +533,12 @@ static int rtl8372n_get_mib_counter(struct rtl837x_priv *priv,
 	return ret;
 }
 
+static bool rtl8372n_uses_tag_8021q(struct rtl837x_priv *priv)
+{
+	return priv->tag_proto == DSA_TAG_PROTO_MXL862_8021Q ||
+	       priv->tag_proto == DSA_TAG_PROTO_VSC73XX_8021Q;
+}
+
 static enum dsa_tag_protocol rtl8372n_get_tag_protocol(struct dsa_switch *ds,
 							int port,
 							enum dsa_tag_protocol mp)
@@ -1444,6 +1440,7 @@ static int rtl8372n_change_tag_protocol(struct dsa_switch *ds,
 
 
 	switch (proto) {
+	case DSA_TAG_PROTO_VSC73XX_8021Q:
 	case DSA_TAG_PROTO_MXL862_8021Q:
 		ret = rtl8372n_teardown_tag_rtl(ds);
 		if (ret)
@@ -1810,10 +1807,11 @@ static int rtl8372n_vlan_add(struct dsa_switch *ds, int port,
 		return -EINVAL;
 	}
 
-	if (vid_is_dsa_8021q(vid) && is_8021q_tag(priv->tag_proto)) {
-		NL_SET_ERR_MSG_MOD(extack, "Range 3072-4095 reserved for dsa_8021q operation");
-		return -EINVAL;
-	}
+	if (vid_is_dsa_8021q(vid) && rtl8372n_uses_tag_8021q(priv))
+    {
+        NL_SET_ERR_MSG_MOD(extack, "Range 3072-4095 reserved for dsa_8021q operation");
+        return -EINVAL;
+    }
 
 	member |= BIT(port);
 
@@ -2186,14 +2184,16 @@ rtl8372n_port_fdb_add(struct dsa_switch *ds, int port,
 					db.type == DSA_DB_PORT ? "DSA_DB_PORT" : "DSA_DB_BRIDGE",
 					port, vid);
 
-	if (db.type == DSA_DB_BRIDGE && is_8021q_tag(priv->tag_proto)) {
+	if (db.type == DSA_DB_BRIDGE && rtl8372n_uses_tag_8021q(priv))
+	{
 		/*
-		 * When the DSA tag protocol is DSA_TAG_PROTO_MXL862_8021Q, the L2 VLAN
-		 * learned on the CPU port is the 802.1q DSA TAG rather than the port's own
-		 * VLAN ID.
-		 * We need add the correct fdb entry
-		 */
-		if (vid == 0) {
+		* With a tag_8021q protocol, the L2 VLAN
+		* learned on the CPU port is the 802.1q DSA TAG rather than the port's own
+		* VLAN ID.
+		* We need add the correct fdb entry
+		*/
+		if (vid == 0)
+		{
 			struct dsa_port *dp;
 
 			dsa_switch_for_each_user_port(dp, ds) {
@@ -2227,8 +2227,10 @@ rtl8372n_port_fdb_del(struct dsa_switch *ds, int port,
 	if (dsa_fdb_present_in_other_db(ds, port, addr, vid, db))
 		return 0;
 
-	if (db.type == DSA_DB_BRIDGE && is_8021q_tag(priv->tag_proto)) {
-		if (vid == 0) {
+	if (db.type == DSA_DB_BRIDGE && rtl8372n_uses_tag_8021q(priv))
+	{
+		if (vid == 0)
+		{
 			struct dsa_port *dp;
 
 			dsa_switch_for_each_user_port(dp, ds) {
@@ -2263,7 +2265,7 @@ rtl8372n_port_fdb_dump(struct dsa_switch *ds, int port,
 		if (entry.addr < i)
 			break;
 		/* We need to hide the dsa_8021q VLANs from the user. */
-		if (vid_is_dsa_8021q(entry.uc.key.vid_fid) && is_8021q_tag(priv->tag_proto))
+		if (vid_is_dsa_8021q(entry.uc.key.vid_fid) && rtl8372n_uses_tag_8021q(priv))
 			entry.uc.key.vid_fid = 0;
 		ret = cb(entry.uc.key.mac_addr, entry.uc.key.vid_fid, entry.uc.is_static,
 				data);
@@ -2905,6 +2907,7 @@ static int rtl8372n_setup(struct dsa_switch *ds)
 
 	rtnl_lock();
 	switch (priv->tag_proto) {
+	case DSA_TAG_PROTO_VSC73XX_8021Q:
 	case DSA_TAG_PROTO_MXL862_8021Q:
 		ret = rtl8372n_set_tag_8021q(ds);
 		break;
@@ -2978,7 +2981,7 @@ static const struct rtl837x_ops rtl8372n_ops = {
 const struct rtl837x_variant rtl8372n_variant = {
 	.ds_ops_mdio = &rtl8372n_switch_ops_mdio,
 	.ops = &rtl8372n_ops,
-	.def_tag_proto = DSA_TAG_PROTO_RTL8_4,
+	.def_tag_proto = DSA_TAG_PROTO_VSC73XX_8021Q,
 	.pl_mac_ops = &rtl8372n_phylink_mac_ops,
 	.have_8224 = false,
 	.chip_data_sz = sizeof(struct rtl8372n),
