+/* Serve tx completion ring N on CPU N+1 and rx ring N on CPU N. ath12k
+ * queues on the TCL ring of the sending CPU, so completions land off the
+ * core that is queueing; rx spreads by the hardware's ring hash. Same
+ * idea as the PPE's edma_irq_set_affinity(). Groups carrying neither a tx
+ * nor an rx ring keep the default.
+ */
+static void ath12k_ahb_dp_irq_set_affinity(struct ath12k_base *ab, int grp_id,
+					   int irq)
+{
+	const struct ath12k_hw_ring_mask *ring_mask = ab->hw_params->ring_mask;
+	int cpu;
+
+	if (ring_mask->tx[grp_id])
+		cpu = fls(ring_mask->tx[grp_id]);		/* ring + 1 */
+	else if (ring_mask->rx[grp_id])
+		cpu = fls(ring_mask->rx[grp_id]) - 1;	/* ring */
+	else
+		return;
+
+	cpu %= num_possible_cpus();
+	if (irq_set_affinity(irq, cpumask_of(cpu)))
+		ath12k_warn(ab, "failed to set affinity of DP irq %d to CPU %d\n",
+			    irq, cpu);
+}
