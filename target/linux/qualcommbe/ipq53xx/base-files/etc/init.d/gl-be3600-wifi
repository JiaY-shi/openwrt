#!/bin/sh /etc/rc.common
#
# GL-BE3600: enable both radios on the first boot only.
#
# Two things make this more than a one-line uci set:
#
#  * wifi config runs early in boot, before the ath12k phys exist, so the
#    wifi-iface sections are created by netifd as each phy registers, and
#    the QCN6432 (5 GHz) registers a few seconds after the IPQ5332.  A
#    boot service that fires before the second one sees default_radio0
#    only, which is why the wait below exists.
#  * /etc/uci-defaults would be the natural place for this, but it runs
#    even earlier and sees no default_radio* at all.
#
# The marker keeps this to one boot: a user who turns a radio off in LuCI
# keeps it off across reboots.
#

START=99

boot() {
	[ -e /etc/gl-be3600-wifi-default ] && return 0

	i=0
	while [ $i -lt 20 ]; do
		uci -q get wireless.default_radio1 >/dev/null 2>&1 && break
		sleep 1
		i=$((i + 1))
	done

	uci -q get wireless.radio0 >/dev/null 2>&1 || return 0

	uci -q set wireless.default_radio0.disabled='0'
	uci -q get wireless.default_radio1 >/dev/null 2>&1 &&
		uci -q set wireless.default_radio1.disabled='0'
	uci commit wireless

	touch /etc/gl-be3600-wifi-default

	wifi up
}
