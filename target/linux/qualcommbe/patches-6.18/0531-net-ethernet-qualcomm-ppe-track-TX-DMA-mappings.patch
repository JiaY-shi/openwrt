From: JiaY-shi <shi05275@163.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: track TX DMA mappings

The TX path maps skb heads and fragments with the DMA API, but completion
reconstructs DMA addresses with virt_to_phys().  That is not the address
returned by dma_map_single() or skb_frag_dma_map(), and the fragment case
even translates the skb_frag_t metadata rather than the fragment data.
It also skips unmapping every descriptor carrying the MORE bit.

Keep software DMA state alongside each TX descriptor.  Return that state
through the opaque completion field, unmap every completed segment with
the matching DMA API and length, and free the skb only when its final
descriptor completes.  Use the same state to unwind partial scatter-gather
mapping failures and outstanding descriptors during ring teardown.

This prevents leaked mappings and invalid cache maintenance on
non-coherent IPQ53xx/IPQ95xx systems.

Signed-off-by: JiaY-shi <shi05275@163.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/edma_tx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_tx.c
@@ -110,6 +110,67 @@
 	}
 }
 
+static void edma_tx_buffer_unmap(struct edma_tx_buffer *buf)
+{
+	struct device *dev = edma_ctx->ppe_dev->dev;
+
+	if (!buf->mapped)
+		return;
+
+	if (buf->page)
+		dma_unmap_page(dev, buf->dma, buf->len, DMA_TO_DEVICE);
+	else
+		dma_unmap_single(dev, buf->dma, buf->len, DMA_TO_DEVICE);
+
+	buf->dma = 0;
+	buf->len = 0;
+	buf->mapped = false;
+	buf->page = false;
+}
+
+static void edma_tx_buffer_set(struct edma_txdesc_ring *txdesc_ring,
+			       struct edma_txdesc_pri *txdesc,
+			       dma_addr_t dma, u32 len, bool page)
+{
+	u32 index = txdesc - txdesc_ring->pdesc;
+	struct edma_tx_buffer *buf = &txdesc_ring->buf[index];
+
+	WARN_ON_ONCE(buf->mapped || buf->skb);
+	buf->dma = dma;
+	buf->len = len;
+	buf->mapped = true;
+	buf->page = page;
+	EDMA_TXDESC_OPAQUE_SET(txdesc, buf);
+}
+
+static void edma_tx_unmap_range(struct edma_txdesc_ring *txdesc_ring,
+				u32 start, u32 end)
+{
+	while (start != end) {
+		struct edma_tx_buffer *buf = &txdesc_ring->buf[start];
+
+		edma_tx_buffer_unmap(buf);
+		buf->skb = NULL;
+		start = (start + 1) & EDMA_TX_RING_SIZE_MASK;
+	}
+}
+
+void edma_tx_ring_buffers_cleanup(struct edma_txdesc_ring *txdesc_ring)
+{
+	u32 i;
+
+	if (!txdesc_ring->buf)
+		return;
+
+	for (i = 0; i < txdesc_ring->count; i++) {
+		struct edma_tx_buffer *buf = &txdesc_ring->buf[i];
+
+		edma_tx_buffer_unmap(buf);
+		dev_kfree_skb_any(buf->skb);
+		buf->skb = NULL;
+	}
+}
