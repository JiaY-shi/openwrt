 /**
+ * struct edma_tx_buffer - software state for one Tx descriptor
+ * @dma: DMA address returned by the mapping API
+ * @skb: packet freed when its final descriptor completes
+ * @len: mapped buffer length
+ * @mapped: whether @dma is currently mapped
+ * @page: whether the buffer was mapped with skb_frag_dma_map()
+ */
+struct edma_tx_buffer {
+	dma_addr_t dma;
+	struct sk_buff *skb;
+	u32 len;
+	bool mapped;
+	bool page;
+};
+
+/**
  * struct edma_txdesc_ring - EDMA Tx descriptor ring
  * @prod_idx: Producer index
  * @id: Tx ring number
@@ -283,6 +299,7 @@
