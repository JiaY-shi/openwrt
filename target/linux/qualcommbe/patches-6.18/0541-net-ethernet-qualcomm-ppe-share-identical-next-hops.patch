 }
 
+static u32 ppe_ft_nexthop_key(const struct ppe_flow_nexthop *nh)
+{
+	u32 port = nh->port | nh->l3_if << 8 | nh->pub_ip_index << 16;
+	u32 tags = (u16)nh->vid | (u32)(u16)nh->svid << 16;
+	u32 mac = jhash(nh->mac, ETH_ALEN, 0);
+
+	return jhash_3words(port, tags, (__force u32)nh->dnat_ip, mac);
+}
+
+static bool ppe_ft_nexthop_match(const struct ppe_flow_nexthop *a,
+				 const struct ppe_flow_nexthop *b)
+{
+	/* Do not hash or compare structure padding. All hardware rewrite
+	 * fields participate, including both tags and the DNAT address.
+	 */
+	return a->port == b->port && a->l3_if == b->l3_if &&
+	       ether_addr_equal(a->mac, b->mac) && a->vid == b->vid &&
+	       a->svid == b->svid && a->pub_ip_index == b->pub_ip_index &&
+	       a->dnat_ip == b->dnat_ip;
+}
+
+/* Called under ft->lock. Acquire the reference before publishing a flow,
+ * and leave it held if deletion of that flow has to be quarantined.
+ */
+static struct ppe_ft_nexthop *
+ppe_ft_nexthop_get(struct ppe_flowtable *ft,
+		   const struct ppe_flow_nexthop *config)
+{
+	u32 key = ppe_ft_nexthop_key(config);
+	struct ppe_ft_nexthop *nh;
+	unsigned int index;
+	int ret;
+
+	lockdep_assert_held(&ft->lock);
+	hash_for_each_possible(ft->nexthops, nh, node, key) {
+		if (!ppe_ft_nexthop_match(&nh->config, config))
+			continue;
+		nh->refcnt++;
+		return nh;
+	}
+
+	index = find_first_zero_bit(ft->nexthop_used,
+				    ft->ppe_dev->variant->num_nexthop_entries);
+	if (index >= ft->ppe_dev->variant->num_nexthop_entries)
+		return ERR_PTR(-ENOSPC);
+	nh = kzalloc(sizeof(*nh), GFP_KERNEL);
+	if (!nh)
+		return ERR_PTR(-ENOMEM);
+
+	ret = ppe_nexthop_set(ft->ppe_dev, index, config);
+	if (ret) {
+		/* No flow can reference a row which was never published. */
+		kfree(nh);
+		return ERR_PTR(ret);
+	}
+	nh->config = *config;
+	nh->index = index;
+	nh->refcnt = 1;
+	set_bit(index, ft->nexthop_used);
+	hash_add(ft->nexthops, &nh->node, key);
+	return nh;
+}
+
+static void ppe_ft_nexthop_put(struct ppe_flowtable *ft,
+			       struct ppe_ft_nexthop *nh)
+{
+	lockdep_assert_held(&ft->lock);
+	if (!nh || --nh->refcnt)
+		return;
+
+	/* Only callers which proved their hardware flow gone drop its
+	 * reference. A quarantined flow continues to pin this exact row.
+	 */
+	hash_del(&nh->node);
+	clear_bit(nh->index, ft->nexthop_used);
+	kfree(nh);
+}
+
