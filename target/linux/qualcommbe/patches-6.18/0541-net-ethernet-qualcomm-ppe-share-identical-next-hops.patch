+/* Flows own references to identical hardware rewrites, not private rows.
+ * Keep the configuration immutable until the last hardware flow is gone.
+ */
+struct ppe_ft_nexthop {
+	struct hlist_node node;
+	struct ppe_flow_nexthop config;
+	unsigned int refcnt;
+	u16 index;
+};
