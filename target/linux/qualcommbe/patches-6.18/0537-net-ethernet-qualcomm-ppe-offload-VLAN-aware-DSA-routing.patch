+/* RTNL serializes this check with bridge membership and VLAN changes. */
+static bool ppe_ft_dsa_owns_dev(struct ppe_flowtable *ft,
+				struct net_device *dev)
+{
+	struct net_device *lower;
+	struct list_head *iter;
+
+	if (is_vlan_dev(dev))
+		dev = vlan_dev_real_dev(dev);
+	if (dsa_user_dev_check(dev)) {
+		struct net_device *conduit =
+			dsa_port_to_conduit(dsa_port_from_netdev(dev));
+		struct edma_port_priv *priv;
+
+		if (!edma_port_dev_check(conduit))
+			return false;
+		priv = netdev_priv(conduit);
+		return priv->ppe_port->ppe_dev == ft->ppe_dev;
+	}
+	if (!netif_is_bridge_master(dev))
+		return false;
+	/* DSA user ports are direct lower devices of their bridge. */
+	netdev_for_each_lower_dev(dev, lower, iter)
+		if (dsa_user_dev_check(lower) && ppe_ft_dsa_owns_dev(ft, lower))
+			return true;
+	return false;
+}
+
+static int ppe_ft_dsa_netdev_event(struct notifier_block *nb,
+				   unsigned long event, void *ptr)
+{
+	struct ppe_flowtable *ft = container_of(nb, struct ppe_flowtable,
+					      dsa_netdev_nb);
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+
+	switch (event) {
+	case NETDEV_DOWN:
+	case NETDEV_UNREGISTER:
+	case NETDEV_CHANGE:
+	case NETDEV_CHANGEADDR:
+	case NETDEV_CHANGEMTU:
+	case NETDEV_CHANGEUPPER:
+		if (ppe_ft_dsa_owns_dev(ft, dev))
+			ppe_ft_flow_drain(ft);
+		break;
+	}
+	return NOTIFY_DONE;
+}
+
+static int ppe_ft_dsa_switchdev_event(struct notifier_block *nb,
+				      unsigned long event, void *ptr)
+{
+	struct ppe_flowtable *ft = container_of(nb, struct ppe_flowtable,
+					      dsa_switchdev_nb);
+	struct net_device *dev = switchdev_notifier_info_to_dev(ptr);
