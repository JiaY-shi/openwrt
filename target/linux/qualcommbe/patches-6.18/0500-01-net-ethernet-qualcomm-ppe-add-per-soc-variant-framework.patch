From: Kenneth Kasilag <kenneth@kasilag.me>
Date: Sun, 05 Jul 2026 00:00:00 +0000
Subject: [PATCH] net: ethernet: qualcomm: ppe: add a per-SoC variant framework

The PPE register block is largely shared across the HPPE, APPE and MPPE
generations. A few things differ: the PPPoE session table depth, the shaper
clock, and availability of the tunnel engine and virtual ports.

Collect the differences into per-SoC match data. Add struct ppe_variant,
attach it through the platform match data, and describe both IPQ9574 APPE and
IPQ5332 MPPE. QCA SSDK builds IPQ5332 as MPPE with 64 PPPoE sessions, a
200 MHz shaper clock, the tunnel engine and virtual ports.

Signed-off-by: Kenneth Kasilag <kenneth@kasilag.me>
Signed-off-by: JiaY-shi <shi05275@163.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe.c
@@ -10,6 +10,7 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/of_device.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
@@ -34,6 +35,7 @@
 /**
  * struct ppe_of_data - PPE private data of IPQ SoC
  * @type: PPE type value
+ * @variant: Optional hardware-offload capabilities
  * @ppe_rate: PPE clock rate
  * @num_ports: Number of PPE ports
  * @regmap_config: Regmap configuration
@@ -41,6 +43,7 @@
  * @num_icc_paths: Number of ICC paths
  */
 struct ppe_of_data {
+	const struct ppe_variant *variant;
 	enum ppe_type type;
 	unsigned long ppe_rate;
 	int num_ports;
@@ -338,6 +341,10 @@
 		return dev_err_probe(dev, PTR_ERR(ppe_dev->regmap),
 				     "PPE initialize regmap failed\n");
 	ppe_dev->dev = dev;
+	ppe_dev->variant = data->variant;
+	if (!ppe_dev->variant)
+		return dev_err_probe(dev, -ENODEV, "Unsupported offload PPE type %d\n",
+				     data->type);
 	ppe_dev->type = data->type;
 	ppe_dev->clk_rate = data->ppe_rate;
 	ppe_dev->num_ports = data->num_ports;
@@ -378,7 +385,24 @@
 	edma_destroy(ppe_dev);
 }
 
+static const struct ppe_variant ppe_variant_ipq5332 = {
+	.name			= "IPQ5332",
+	.num_pppoe_sessions	= 64,
+	.shaper_clock_khz	= 200000,
+	.has_tunnel_engine	= true,
+	.has_vports		= true,
+};
+
+static const struct ppe_variant ppe_variant_ipq9574 = {
+	.name			= "IPQ9574",
+	.num_pppoe_sessions	= 64,
+	.shaper_clock_khz	= 353000,
+	.has_tunnel_engine	= true,
+	.has_vports		= true,
+};
+
 static const struct ppe_of_data ipq9574_data = {
+	.variant = &ppe_variant_ipq9574,
 	.type = IPQ9574_PPE,
 	.ppe_rate = IPQ9574_PPE_CLK_RATE,
 	.num_ports = IPQ9574_PPE_PORT_MAX,
@@ -397,6 +421,7 @@
 };
 
 static const struct ppe_of_data ipq5332_data = {
+	.variant = &ppe_variant_ipq5332,
 	.type = IPQ5332_PPE,
 	.ppe_rate = IPQ5332_PPE_CLK_RATE,
 	.num_ports = IPQ5332_PPE_PORT_MAX,
--- a/drivers/net/ethernet/qualcomm/ppe/ppe.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe.h
@@ -14,6 +14,38 @@
 struct dentry;
 
 struct ppe_ports;
+
+/* Per-SoC PPE parameters. The PPE register layer is shared between the
+ * HPPE (IPQ807x) and APPE (IPQ9574) generations; this collects the few
+ * things that actually differ so the shared code stays chip-agnostic.
+ * The table geometry (flow/host/VSI/XLT/MY_MAC/PUB_IP/nexthop) is
+ * identical across both generations and stays as the compile-time
+ * PPE_*_ENTRIES macros.
+ */
+struct ppe_variant {
+	const char *name;
+
+	/* PPPoE session table depth: 64 on APPE, 16 on HPPE. The bank
+	 * base addresses live in the APPE tunnel block; an HPPE port must
+	 * relocate them (see ppe_pppoe_session_set()).
+	 */
+	u16 num_pppoe_sessions;
+
+	/* Port shaper token clock, in kHz (353000 on APPE, 300000 on
+	 * HPPE).
+	 */
+	u32 shaper_clock_khz;
+
+	/* On-die tunnel engine (VXLAN/GENEVE/MAP-T). APPE only; gates the
+	 * flowtable tunnel seam.
+	 */
+	bool has_tunnel_engine;
+
+	/* Virtual ports 64..255 for binding non-PPE netdevs such as wifi
+	 * VAPs. APPE only; consumed by the virtual-port offload work.
+	 */
+	bool has_vports;
+};
 
 /**
  * enum ppe_type - PPE device type.
@@ -50,6 +82,7 @@
 	struct device *dev;
 	struct regmap *regmap;
 	enum ppe_type type;
+	const struct ppe_variant *variant;
 	unsigned long clk_rate;
 	unsigned int num_ports;
 	struct dentry *debugfs_root;
