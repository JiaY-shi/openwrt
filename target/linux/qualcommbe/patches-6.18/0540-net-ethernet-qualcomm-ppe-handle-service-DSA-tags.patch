 }
 
+/* Role bit 0 selects ingress S-tag parsing, bit 1 selects egress S-tag
+ * retention. CPU ingress stays unchanged because EDMA injects DSA tags.
+ */
+int ppe_port_qinq_role_get(struct ppe_device *ppe_dev, int port, u8 *role)
+{
+	u32 in, out;
+	int ret;
+
+	if (port < 0 || port >= ppe_dev->num_ports)
+		return -EINVAL;
+	ret = regmap_read(ppe_dev->regmap,
+			  PPE_PORT_PARSING_ADDR + PPE_PORT_PARSING_INC * port, &in);
+	if (ret)
+		return ret;
+	ret = regmap_read(ppe_dev->regmap,
+			  PPE_PORT_EG_VLAN_TBL_ADDR + PPE_PORT_EG_VLAN_TBL_INC * port,
+			  &out);
+	if (ret)
+		return ret;
+	*role = FIELD_GET(PPE_PORT_PARSING_SERVICE, in) |
+		(FIELD_GET(PPE_PORT_EG_VLAN_TBL_VLAN_TYPE, out) << 1);
+	return 0;
+}
+
+int ppe_port_qinq_role_set(struct ppe_device *ppe_dev, int port, u8 role)
+{
+	u32 in_reg = PPE_PORT_PARSING_ADDR + PPE_PORT_PARSING_INC * port;
+	u32 out_reg = PPE_PORT_EG_VLAN_TBL_ADDR + PPE_PORT_EG_VLAN_TBL_INC * port;
+	u8 old_role;
+	int ret, err;
+
+	ret = ppe_port_qinq_role_get(ppe_dev, port, &old_role);
+	if (ret)
+		return ret;
+	if (port) {
+		ret = regmap_update_bits(ppe_dev->regmap, in_reg,
+					 PPE_PORT_PARSING_SERVICE,
+					 role & BIT(0));
+		if (ret)
+			return ret;
+	}
+	ret = regmap_update_bits(ppe_dev->regmap, out_reg,
+				 PPE_PORT_EG_VLAN_TBL_VLAN_TYPE,
+				 !!(role & BIT(1)));
+	if (ret && port) {
+		err = regmap_update_bits(ppe_dev->regmap, in_reg,
+					 PPE_PORT_PARSING_SERVICE,
+					 old_role & BIT(0));
+		if (err)
+			dev_err(ppe_dev->dev, "port %d QinQ role rollback failed\n", port);
+	}
+	return ret;
+}
