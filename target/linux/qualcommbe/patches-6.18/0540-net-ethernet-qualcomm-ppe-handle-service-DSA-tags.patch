+/**
+ * ppe_ing_stacked_xlt_rule_set - Classify an optional S-tag and C-tag
+ * @ppe_dev: PPE device
+ * @index: Translation rule index
+ * @port_bitmap: Ingress PPE ports
+ * @vid: C-VLAN ID, negative for untagged or priority-tagged C-VLAN
+ * @svid: S-VLAN ID, negative when no S-tag is present
+ * @vsi: Ingress VSI assigned by the rule
+ * @strip_tags: Delete the matched tags after classification
+ *
+ * DSA service tags are retained on CPU-bound packets; the tagger removes
+ * the outer service tag and the bridge processes the customer VLAN.
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_ing_stacked_xlt_rule_set(struct ppe_device *ppe_dev, int index,
+				 unsigned int port_bitmap, int vid, int svid,
+				 int vsi, bool strip_tags)
+{
 	u32 rule[4] = {}, action[4] = {};
 	unsigned int fmt;
 	u32 reg;
@@ -1645,7 +1668,10 @@
