+	if (svid >= 0)
+		rule[0] |= FIELD_PREP(PPE_XLT_RULE_W0_SKEY_FMT, PPE_XLT_FMT_TAGGED) |
+			   PPE_XLT_RULE_W0_SKEY_VID_INCL |
+			   FIELD_PREP(PPE_XLT_RULE_W0_SKEY_VID, svid);
+	else
