+static bool ppe_ft_service_port_used(struct ppe_flowtable *ft, int port)
+{
+	int i;
+
+	for (i = 0; i < PPE_L3_VLAN_UPLINKS; i++)
+		if (ft->vlans[i].ref.refcnt && ft->vlans[i].svid >= 0 &&
+		    (port < 0 || ft->vlans[i].port == port))
+			return true;
+	return false;
+}
+
+static int ppe_ft_service_port_restore(struct ppe_flowtable *ft, int port)
+{
+	int ret = 0, err;
+
+	if (!ppe_ft_service_port_used(ft, port))
+		ret = ppe_port_qinq_role_set(ft->ppe_dev, port,
+					     ft->service_port_role[port]);
+	if (!ppe_ft_service_port_used(ft, -1)) {
+		err = ppe_port_qinq_role_set(ft->ppe_dev, 0, ft->service_cpu_role);
+		if (!ret)
+			ret = err;
+	}
+	return ret;
+}
+
+static int ppe_ft_service_port_get(struct ppe_flowtable *ft, int port,
+				   bool *poisoned)
+{
+	int ret, err;
+
+	if (port <= 0 || port >= ft->ppe_dev->num_ports ||
+	    port >= ARRAY_SIZE(ft->service_port_role))
+		return -EINVAL;
+	if (ppe_ft_service_port_used(ft, port))
+		return 0;
+	ret = ppe_port_qinq_role_get(ft->ppe_dev, port,
+				     &ft->service_port_role[port]);
+	if (ret)
+		return ret;
+	if (!ppe_ft_service_port_used(ft, -1)) {
+		ret = ppe_port_qinq_role_get(ft->ppe_dev, 0, &ft->service_cpu_role);
+		if (ret)
+			return ret;
+		ret = ppe_port_qinq_role_set(ft->ppe_dev, 0,
+					     ft->service_cpu_role | BIT(1));
+		if (ret)
+			goto restore;
+	}
+	ret = ppe_port_qinq_role_set(ft->ppe_dev, port, BIT(0) | BIT(1));
+	if (!ret)
+		return 0;
+restore:
+	err = ppe_ft_service_port_restore(ft, port);
+	if (err)
+		*poisoned = true;
+	return ret;
 }
 
