+/* Ingress QinQ parsing: service ports recognize an outer S-tag. */
+#define PPE_PORT_PARSING_ADDR			0x1e0000
+#define PPE_PORT_PARSING_INC			4
+#define PPE_PORT_PARSING_SERVICE			BIT(0)
+
 /* PPE port egress VLAN configurations. */
 #define PPE_PORT_EG_VLAN_TBL_ADDR		0x20020
 #define PPE_PORT_EG_VLAN_TBL_ENTRIES		8
